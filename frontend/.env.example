# OrbitOS Frontend Environment Variables
# If connecting to an external backend (e.g. deployed on Render, Railway, Fly.io, or VPS):
# VITE_API_URL=https://your-backend-app.onrender.com
# VITE_WS_URL=wss://your-backend-app.onrender.com/ws/v1/simulation

# If left empty, OrbitOS runs in autonomous standalone interactive mode on Vercel

